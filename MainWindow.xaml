<Window
    x:Class="ClipboardManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ClipboardManager.ViewModels"
    xmlns:models="using:ClipboardManager.Models"
    Title="Clipboard Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Clipboard History View -->
        <Grid x:Name="HistoryView" Background="Transparent" Padding="16" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                <TextBox 
                    Grid.Column="0" 
                    PlaceholderText="Search clipboard history..." 
                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    HorizontalAlignment="Stretch" />
                
                <Button 
                    Grid.Column="1" 
                    Content="Clear Unpinned" 
                    Command="{Binding ClearUnpinnedCommand}" 
                    ToolTipService.ToolTip="Delete all unpinned items from history" />

                <Button 
                    Grid.Column="2" 
                    x:Name="SettingsButton"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings"
                    Padding="8,6">
                    <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                </Button>
            </Grid>

            <ListView 
                x:Name="HistoryListView"
                Grid.Row="1" 
                ItemsSource="{Binding HistoryItems}" 
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnClipboardItemClicked"
                ShowsScrollingPlaceholders="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.IsVerticalScrollChainingEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled">
                
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" RowDefinitions="Auto,Auto">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Pin / Unpin" 
                                                    Click="PinItem_Click" />
                                    <MenuFlyoutItem Text="Delete" 
                                                    Click="DeleteItem_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- Text Preview Block -->
                            <TextBlock 
                                Grid.Row="0" 
                                Text="{Binding TextPreview}" 
                                Visibility="{Binding HasText}"
                                TextTrimming="CharacterEllipsis" 
                                MaxLines="2" 
                                TextWrapping="Wrap" 
                                Margin="0,0,0,8" />

                            <!-- Image Preview Block -->
                            <Image 
                                Grid.Row="0"
                                Source="{Binding ImagePreview}"
                                Visibility="{Binding HasImage}"
                                MaxHeight="120"
                                Stretch="Uniform"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
                            
                            <!-- Metadata Block -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock 
                                    Text="📌" 
                                    Visibility="{Binding PinnedVisibility}" 
                                    FontSize="12"/>
                                <TextBlock 
                                    Text="{Binding FormatBadge}" 
                                    FontSize="12" 
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemAccentColorLight2}" />
                                <TextBlock 
                                    Text="{Binding TimestampString}" 
                                    FontSize="12" 
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Settings View -->
        <Grid x:Name="SettingsView" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Padding="16,12,16,12" ColumnDefinitions="Auto, *" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Button 
                    x:Name="BackButton" 
                    Click="BackButton_Click" 
                    ToolTipService.ToolTip="Back to clipboard history">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                        <TextBlock Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock 
                    Grid.Column="1" 
                    Text="Settings" 
                    FontSize="18" 
                    FontWeight="SemiBold" 
                    VerticalAlignment="Center" />
            </Grid>
            <Frame Grid.Row="1" x:Name="SettingsFrame" />
        </Grid>
    </Grid>
</Window>
