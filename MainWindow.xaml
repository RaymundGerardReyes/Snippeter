<Window
    x:Class="ClipboardManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ClipboardManager.ViewModels"
    xmlns:models="using:ClipboardManager.Models"
    Title="Clipboard Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="16" RowDefinitions="Auto,*">
        
        <TextBox 
            Grid.Row="0" 
            PlaceholderText="Search clipboard history..." 
            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,16" 
            HorizontalAlignment="Stretch" />

        <ListView 
            Grid.Row="1" 
            ItemsSource="{Binding HistoryItems}" 
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnClipboardItemClicked"
            ShowsScrollingPlaceholders="True">
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" RowDefinitions="Auto,Auto">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pin / Unpin" 
                                                Click="PinItem_Click" />
                                <MenuFlyoutItem Text="Delete" 
                                                Click="DeleteItem_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Text Preview Block -->
                        <TextBlock 
                            Grid.Row="0" 
                            Text="{Binding TextPreview}" 
                            Visibility="{Binding HasText}"
                            TextTrimming="CharacterEllipsis" 
                            MaxLines="2" 
                            TextWrapping="Wrap"
                            Margin="0,0,0,8" />

                        <!-- Image Preview Block -->
                        <Image 
                            Grid.Row="0"
                            Source="{Binding ImagePreview}"
                            Visibility="{Binding HasImage}"
                            MaxHeight="120"
                            Stretch="Uniform"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"/>
                        
                        <!-- Metadata Block -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock 
                                Text="📌" 
                                Visibility="{Binding PinnedVisibility}" 
                                FontSize="12"/>
                            <TextBlock 
                                Text="{Binding FormatBadge}" 
                                FontSize="12" 
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemAccentColorLight2}" />
                            <TextBlock 
                                Text="{Binding TimestampString}" 
                                FontSize="12" 
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
