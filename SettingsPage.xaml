<Page
    x:Class="ClipboardManager.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock Text="Privacy Engine Controller Settings" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
            <TextBlock Text="Configure double-layer masking rules, structural redactions, domain allowlists, and GPU-accelerated ML secret detection." FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <!-- Layer 1: Core Masking Controls -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Layer 1: Structural Redaction Controls" FontSize="18" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="Mask Private IP Addresses (10.x, 192.168.x, 172.16.x)" IsOn="{Binding MaskPrivateIp, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Mask Public IP &amp; IPv6 Addresses" IsOn="{Binding MaskPublicIp, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Mask Hostnames &amp; Domain Names" IsOn="{Binding MaskDomainNames, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Mask Port Numbers in URIs (e.g. :5432)" IsOn="{Binding MaskPortNumbers, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Mask Database Names in URIs (e.g. /prod_db)" IsOn="{Binding MaskDatabaseNames, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Mask Standalone Hash IDs (UUIDs, SHA256, MD5)" IsOn="{Binding MaskHashIds, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Controller: Double-Layer Masking -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Double-Layer Masking Verification Controller" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="When active, ClipboardManager executes a second verification pass on the masked text to guarantee zero residual leaks." FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <ToggleSwitch Header="Enable Double-Layer Verification Pass" IsOn="{Binding EnableDoubleLayerMasking, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Domain Allowlist -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Preserved Domain Allowlist" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Specified domains will never be redacted even if present inside connection strings or URLs." FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="Enter domain (e.g. mycompany.com)" Text="{Binding NewAllowedDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Add Domain" Command="{Binding AddAllowedDomainCommand}" Grid.Column="1"/>
                    </Grid>

                    <ListView ItemsSource="{Binding AllowedDomains}" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Padding="4">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    <Button Content="Remove" Command="{Binding DataContext.RemoveAllowedDomainCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Grid.Column="1" Size="Small"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Custom Blocklist -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Custom Regex Pattern Blocklist" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Specify additional custom regular expressions to always redact from copied text." FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="Enter Regex pattern (e.g. CONFIDENTIAL-[0-9]+)" Text="{Binding NewBlockedPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Add Pattern" Command="{Binding AddBlockedPatternCommand}" Grid.Column="1"/>
                    </Grid>

                    <ListView ItemsSource="{Binding CustomBlockedPatterns}" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Padding="4">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    <Button Content="Remove" Command="{Binding DataContext.RemoveBlockedPatternCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Grid.Column="1" Size="Small"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Phase 3: GPU ML Secret Detection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Phase 3: Hybrid GPU ML Secret Detection (ONNX / DirectML)" FontSize="18" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="Enable AI-Assisted Secret Detection (RTX 4050 / DirectML)" IsOn="{Binding EnableMlSecretDetection, Mode=TwoWay}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Model Version:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MlModelVersion}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
