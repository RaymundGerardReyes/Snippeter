<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClipboardManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform Condition=" '$(Platform)' == '' or '$(Platform)' == 'AnyCPU' ">x64</Platform>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Configure as a standalone, unpackaged executable -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Nullable>enable</Nullable>
    <!-- Versioning -->
    <Version>1.2.2</Version>
    <!-- Fixes the NETSDK1206 Warning -->
    <UseRidGraph>true</UseRidGraph>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="0.22.0-preview.24378.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.19.0" />
    <Compile Remove="ml\**" />
    <Compile Remove="XamlStubs.g.cs" />
  </ItemGroup>
  <Target Name="EnsureIntermediateXamlDirectory" BeforeTargets="PrepareForBuild;GenerateTemporaryTargetAssembly;CoreCompile;MarkupCompilePass1;Build;Publish">
    <MakeDir Directories="$(IntermediateOutputPath);$(IntermediateOutputPath)intermediatexaml" />
  </Target>
  <Target Name="GenerateProjectPriPostPublish" AfterTargets="Publish">
    <PropertyGroup>
      <StagingDir>$(IntermediateOutputPath)pristaging</StagingDir>
      <MakePriExe>C:\Users\LOQ\.nuget\packages\microsoft.windows.sdk.buildtools\10.0.22621.756\bin\10.0.22621.0\x64\makepri.exe</MakePriExe>
    </PropertyGroup>
    <MakeDir Directories="$(StagingDir)" />
    <Exec Command="xcopy /y /q &quot;$(IntermediateOutputPath)*.xbf&quot; &quot;$(StagingDir)\&quot;" IgnoreExitCode="true" />
    <Exec Command="xcopy /y /q &quot;$(IntermediateOutputPath)*.xaml&quot; &quot;$(StagingDir)\&quot;" IgnoreExitCode="true" />
    <Exec Command="xcopy /y /q &quot;$(PublishDir)Microsoft.UI.Xaml.Controls.pri&quot; &quot;$(StagingDir)\&quot;" IgnoreExitCode="true" />
    <Exec Command="&quot;$(MakePriExe)&quot; createconfig /cf &quot;$(StagingDir)\priconfig.xml&quot; /dq en-US /O" />
    <Exec Command="&quot;$(MakePriExe)&quot; new /pr &quot;$(StagingDir)&quot; /cf &quot;$(StagingDir)\priconfig.xml&quot; /of &quot;$(PublishDir)resources.pri&quot; /O" />
    <Exec Command="xcopy /y /q &quot;$(IntermediateOutputPath)*.xbf&quot; &quot;$(PublishDir)&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
